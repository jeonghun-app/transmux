/configs/local*.json
/tmp/
/.env.solution
/tests/browser/node_modules/
/tests/browser/test-results/
/tests/browser/playwright-report/
/tests/browser/artifacts/
__pycache__/

# Editor and OS noise.
.DS_Store
*.swp
.idea/
.vscode/
